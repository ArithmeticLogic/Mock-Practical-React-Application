// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Artist {
  id   Int    @id @default(autoincrement())
  name String

  song Song[]
}

model Album {
  id          Int      @id @default(autoincrement())
  title       String
  releaseDate DateTime @default(now())

  song Song[]
}

model Genre {
  id   Int    @id @default(autoincrement())
  name String

  song Song[]
}

// TEMP: User has no relation
model User {
  id        Int      @id @default(autoincrement())
  name      String
  createdAt DateTime @default(now())
}

model Song {
  id              Int      @id @default(autoincrement())
  title           String
  releaseDate     DateTime @default(now())
  durationSeconds Int
  artists         Artist[] // No id for these // might be better as the way I did it last
  album           Album?   @relation(fields: [albumId], references: [id])
  albumId         Int?
  genre           Genre[] // No id for these // might be better as the way I did it last
}
